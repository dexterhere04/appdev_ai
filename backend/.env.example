# Backend configuration (v1). Copy to backend/.env or export in the container.
# NEVER commit real secrets. FCB_SECRET is REQUIRED in production.

# Signing key for session/preview tokens. MUST be set (long random string).
FCB_SECRET=

# Frontend origin allowlist (comma-separated). NO wildcard in production.
FCB_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# SQLite metadata store + on-disk workspace root.
FCB_DB_PATH=var/app.db
FCB_WORKSPACES_ROOT=workspaces

# Optional AI pipeline (Gemini). Without it the AI feature uses a fallback.
GEMINI_API_KEY=

# Optional LangSmith tracing.
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false

# Policy
FCB_SESSION_TTL_DAYS=30
FCB_MAX_PROJECTS_PER_USER=10
FCB_MAX_CONCURRENT_BUILDS=2
FCB_MAX_DEV_SERVERS_PER_USER=3
FCB_BUILD_TIMEOUT_S=600
FCB_BUILD_MEM_LIMIT_BYTES=2147483648

# Rate limiting
FCB_RATE_LIMIT_ENABLED=true
FCB_RATE_LIMIT_AUTH_PER_MIN=10
FCB_RATE_LIMIT_CREATE_PER_MIN=6
